rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users Collection
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      
      allow create: if isOwner(uid) 
                    // Cannot create yourself as admin
                    && request.resource.data.role == 'user'
                    // Cannot set payment verification fields on creation
                    && !('paymentVerified' in request.resource.data);
                    
      allow update: if isOwner(uid)
                    // Cannot promote self to admin
                    && request.resource.data.role == resource.data.role
                    // Cannot modify payment fields
                    && (!('paymentVerified' in request.resource.data) || request.resource.data.paymentVerified == resource.data.paymentVerified);
                    
      allow delete: if isAdmin();
    }
    
    // Offers Collection
    match /offers/{offerId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }
    
    // Analyses Collection
    match /offerAnalyses/{analysisId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin(); 
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
