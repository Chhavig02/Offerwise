PORT=3001

# Postgres connection string used by Prisma and backend/test-db.js
DATABASE_URL=

# Origin allowed to call this API (CORS)
FRONTEND_URL=http://localhost:3000

# AI Providers
GEMINI_API_KEY=
CLAUDE_API_KEY=
GROQ_API_KEY=

# Company research (web search)
TAVILY_API_KEY=

# Market compensation benchmarking (Adzuna Job Search API)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Firebase Admin (only the project ID is used -- verifyIdToken fetches
# Google's public certs directly, no service account credential needed)
FIREBASE_PROJECT_ID=offerwise-57d08

# Comma-separated list of email addresses allowed to use the /api/admin routes
# (view/download every user's uploaded offer letters). Leave empty to disable
# admin access entirely.
ADMIN_EMAILS=
